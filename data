        grid.innerHTML = blogArticles.map(art => `<div class="blog-card" onclick="openBlogPost(${art.id})"><div class="blog-image"><img src="${art.image}" alt="${art.title}"></div><div class="blog-content"><h3 class="blog-title">${art.title}</h3><div class="blog-excerpt">${art.excerpt}</div></div></div>`).join('');
    }

    function openProfilePage() { if (!currentUser) { openModal('modal-account'); return; } hideAllPages(); document.getElementById('profilePage').classList.add('active'); renderProfile(); window.location.hash = 'profile'; window.scrollTo({ top: 0, behavior: 'smooth' }); }
    function navigateHome() { hideAllPages(); document.getElementById('mainContent').classList.remove('hidden'); window.location.hash = ''; window.scrollTo({ top: 0, behavior: 'smooth' }); updateUserIcon(); }
    
    // Новая функция для открытия страницы с подробностями экологичности
    function openEcoDetailsPage() {
        hideAllPages();
        document.getElementById('ecoDetailsPage').classList.add('active');
        window.location.hash = 'eco-details';
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // ---------- ПРОФИЛЬ И ПОЛЬЗОВАТЕЛИ ----------
    function registerOrLogin() {
        const name = document.getElementById('reg-name').value.trim();
        const email = document.getElementById('reg-email').value.trim();
        const password = document.getElementById('reg-password').value.trim();
        if(!name || !email || !password) { showToast('Заполните все поля'); return; }
        let user = users.find(u => u.email === email);
        if(!user) {
            user = { name, email, password, orders: [] };
            users.push(user);
            localStorage.setItem('gl_users', JSON.stringify(users));
            showToast('Регистрация успешна!');
        } else if(user.password !== password) { showToast('Неверный пароль'); return; }
        currentUser = user;
        localStorage.setItem('gl_currentUser', JSON.stringify(currentUser));
        closeAllModals();
        updateUserIcon();
        showToast(`Добро пожаловать, ${user.name}!`);
        openProfilePage();
    }
    function logout() {
        currentUser = null;
        localStorage.removeItem('gl_currentUser');
        updateUserIcon();
        navigateHome();
        showToast('Вы вышли из аккаунта');
    }
    function updateUserIcon() {
        const iconDiv = document.getElementById('userIcon');
        if(currentUser) {
            iconDiv.innerHTML = `<div class="user-avatar">${currentUser.name.charAt(0).toUpperCase()}</div><span class="user-name">${currentUser.name}</span>`;
        } else {
            iconDiv.innerHTML = `<i class="fas fa-user"></i>`;
        }
    }
    function renderProfile() {
        const container = document.getElementById('profileContent');
        if(!currentUser) { container.innerHTML = '<p>Пожалуйста, войдите в аккаунт</p>'; return; }
        let ordersHtml = '<div class="orders-list"><h3>История заказов</h3>';
        if(currentUser.orders.length === 0) ordersHtml += '<p>У вас пока нет заказов.</p>';
        else {
            currentUser.orders.forEach((order, idx) => {
                ordersHtml += `<div class="order-item"><div class="order-header"><span>Заказ №${idx+1}</span><span>${order.date}</span></div><div class="order-products">Товары: ${order.items.map(i => `${i.name} x${i.qty}`).join(', ')}<br>Сумма: ${order.total} ₽</div></div>`;
            });
        }
        ordersHtml += '</div>';
        container.innerHTML = `<div class="profile-info"><div class="profile-field"><strong>Имя:</strong> ${currentUser.name}</div><div class="profile-field"><strong>Email:</strong> ${currentUser.email}</div></div>${ordersHtml}<button class="btn btn-secondary" style="margin-top:20px;" onclick="logout()">Выйти из аккаунта</button>`;
    }

    // ---------- КОРЗИНА, ИЗБРАННОЕ, ЗАКАЗЫ ----------
    function addToCart(id) {
        let item = cart.find(i => i.id === id);
        if(item) item.qty++; else cart.push({ id, qty:1 });
        saveData(); updateCounters(); showToast('Товар добавлен в корзину');
        if(document.getElementById('categoryPage').classList.contains('active')) { let cat = window.location.hash.split('/')[1]; if(cat) openCategoryPage(cat); }
    }
    function removeFromCart(id) { cart = cart.filter(i => i.id !== id); saveData(); updateCounters(); renderCart(); }
    function changeQty(id, delta) { let item = cart.find(i => i.id === id); if(item) { item.qty += delta; if(item.qty <= 0) removeFromCart(id); else { saveData(); renderCart(); updateCounters(); } } }
    function renderCart() {
        const container = document.getElementById('cart-items'), totalEl = document.getElementById('cart-total');
        if(cart.length===0) { container.innerHTML = '<p style="text-align:center; color:#757575; padding:40px;">Корзина пуста</p>'; totalEl.innerText = '0 ₽'; return; }
        let total=0;
        container.innerHTML = cart.map(item => { let p=productsDB.find(p=>p.id===item.id); let sum=p.price*item.qty; total+=sum; 
            const productImage = p.image ? `<img src="${p.image}" class="product-thumb" alt="${p.name}">` : `<span style="font-size:40px;">${p.emoji}</span>`;
            return `<div class="cart-item"><div class="cart-item-info">${productImage}<div><div style="font-weight:600;">${p.name}</div><div style="font-size:13px;">${p.price} ₽</div><div><button onclick="changeQty(${item.id},-1)">-</button><span>${item.qty}</span><button onclick="changeQty(${item.id},1)">+</button></div></div></div><div style="text-align:right;"><div style="font-weight:bold;">${sum} ₽</div><button onclick="removeFromCart(${item.id})"><i class="fas fa-trash"></i> Удалить</button></div></div>`;
        }).join('');
        totalEl.innerText = total.toLocaleString() + ' ₽';
    }
    function toggleWishlist(id) {
        if(wishlist.includes(id)) { wishlist = wishlist.filter(i=>i!==id); showToast('Удалено из избранного'); }
        else { wishlist.push(id); showToast('Добавлено в избранное ❤️'); }
        saveData(); updateCounters();
        if(document.getElementById('categoryPage').classList.contains('active')) { let cat = window.location.hash.split('/')[1]; if(cat) openCategoryPage(cat); }
        renderWishlist();
    }
    function renderWishlist() {
        const container = document.getElementById('wishlist-items');
        if(wishlist.length===0) { container.innerHTML = '<p style="text-align:center; padding:40px;">Список избранного пуст</p>'; return; }
        container.innerHTML = wishlist.map(id => { let p=productsDB.find(p=>p.id===id);
            const productImage = p.image ? `<img src="${p.image}" class="product-thumb" alt="${p.name}">` : `<span style="font-size:40px;">${p.emoji}</span>`;
            return `<div class="wishlist-item"><div class="wishlist-item-info">${productImage}<div><div style="font-weight:600;">${p.name}</div><div style="color:var(--primary-green);">${p.price} ₽</div></div></div><div><button class="btn btn-primary" style="padding:8px 16px;" onclick="addToCart(${p.id})">В корзину</button><button onclick="toggleWishlist(${p.id})"><i class="fas fa-trash"></i></button></div></div>`;
        }).join('');
    }
    function showIngredients(id) { let p=productsDB.find(p=>p.id===id); if(p) { document.getElementById('ingredients-text').innerHTML = `<strong>${p.name}</strong><br><br>${p.ingredients}`; openModal('modal-ingredients'); } }
    function openCheckoutForm() { if(cart.length===0) { showToast('Корзина пуста'); return; } openModal('modal-checkout'); updateCheckoutSummary(); }
    
    // Обновление суммы в чекбоксе
    function updateCheckoutSummary() {
        let subtotal = cart.reduce((sum, item) => sum + item.qty * (productsDB.find(p => p.id === item.id)?.price || 0), 0);
        let offset = document.getElementById('carbonOffsetCheckbox')?.checked ? 50 : 0;
        let total = subtotal + offset;
        let summaryDiv = document.getElementById('checkoutSummary');
        if (summaryDiv) {
            summaryDiv.innerHTML = `
                <div class="summary-row"><span>Товары:</span><span>${subtotal} ₽</span></div>
                ${offset ? '<div class="summary-row"><span>Компенсация CO₂:</span><span>50 ₽</span></div>' : ''}
                <div class="summary-row summary-total"><span>Итого к оплате:</span><span>${total} ₽</span></div>
            `;
        }
    }
    
    document.getElementById('carbonOffsetCheckbox')?.addEventListener('change', updateCheckoutSummary);
    
    document.getElementById('checkout-form')?.addEventListener('submit', function(e) {
        e.preventDefault();
        let name = document.getElementById('checkout-name').value.trim(), phone = document.getElementById('checkout-phone').value.trim(), address = document.getElementById('checkout-address').value.trim();
        if(!name || !phone || !address) { showToast('Заполните обязательные поля'); return; }
        let orderItems = cart.map(item => { let p=productsDB.find(p=>p.id===item.id); return { name:p.name, qty:item.qty, price:p.price }; });
        let subtotal = cart.reduce((s,item)=>s+item.qty*productsDB.find(p=>p.id===item.id).price,0);
        let offset = document.getElementById('carbonOffsetCheckbox')?.checked ? 50 : 0;
        let total = subtotal + offset;
        let order = { date: new Date().toLocaleString(), items: orderItems, total: total, carbonOffset: offset > 0 };
        if(currentUser) {
            currentUser.orders.push(order);
            let userIndex = users.findIndex(u => u.email === currentUser.email);
            if(userIndex !== -1) users[userIndex] = currentUser;
            localStorage.setItem('gl_users', JSON.stringify(users));
            localStorage.setItem('gl_currentUser', JSON.stringify(currentUser));
        }
        cart = []; saveData(); updateCounters(); closeAllModals(); navigateHome();
        alert(`Спасибо, ${name}! Ваш заказ на сумму ${total}₽ принят. ${offset ? 'Вы поддержали посадку леса 🌲' : ''}`);
    });

    // ---------- ТЕСТ (сокращён, но рабочий) ----------
    function startQuiz() { quizCurrentStep=0; quizAnswers=[]; renderQuizStep(); openModal('modal-quiz'); }
    function renderQuizStep() {
        const container = document.getElementById('quiz-container');
        if(quizCurrentStep < quizQuestions.length) {
            let q = quizQuestions[quizCurrentStep];
            let html = `<div class="quiz-question"><p>${quizCurrentStep+1}. ${q.text}</p>` + q.options.map(opt => `<label class="quiz-option"><input type="radio" name="q${quizCurrentStep}" value="${opt}"> ${opt}</label>`).join('') + `</div><div class="quiz-nav"><button class="btn btn-secondary" onclick="prevQuizStep()" ${quizCurrentStep===0?'disabled':''}>Назад</button><button class="btn btn-primary" onclick="nextQuizStep()">Далее</button></div>`;
            container.innerHTML = html;
            if(quizAnswers[quizCurrentStep]) { let val=quizAnswers[quizCurrentStep]; document.querySelectorAll(`input[name="q${quizCurrentStep}"]`).forEach(r=>{if(r.value===val) r.checked=true;}); }
        } else {
            let recIds = [1,6,8]; // упрощённые рекомендации
            let recProducts = recIds.map(id=>productsDB.find(p=>p.id===id)).filter(p=>p);
            let html = `<h3>Ваши персональные рекомендации</h3><p>На основе ответов мы подобрали для вас:</p>` + recProducts.map(prod => `<div class="quiz-result-item"><div><strong>${prod.name}</strong> — ${prod.price} ₽<br><small>${prod.desc}</small></div><button class="btn btn-primary" onclick="addToCart(${prod.id}); showToast('${prod.name} добавлен');">В корзину</button></div>`).join('') + `<div class="quiz-nav"><button class="btn btn-secondary" onclick="closeQuiz()">Закрыть</button></div>`;
            container.innerHTML = html;
        }
    }
    function nextQuizStep() { let selected = document.querySelector(`input[name="q${quizCurrentStep}"]:checked`); if(!selected) { showToast('Выберите ответ'); return; } quizAnswers[quizCurrentStep] = selected.value; quizCurrentStep++; renderQuizStep(); }
    function prevQuizStep() { if(quizCurrentStep>0) { quizCurrentStep--; renderQuizStep(); } }
    function closeQuiz() { closeAllModals(); }

    // ---------- ОБЩИЕ ----------
    function openModal(id) { 
        closeAllModals(); 
        document.getElementById('modal-overlay').classList.add('active'); 
        document.getElementById(id).classList.remove('hidden'); 
        if(id==='modal-cart') renderCart(); 
        if(id==='modal-wishlist') renderWishlist(); 
        if(id==='modal-categories') showCategories(); 
        if(id==='modal-checkout') updateCheckoutSummary();
    }
    function closeAllModals() { document.getElementById('modal-overlay').classList.remove('active'); document.querySelectorAll('.modal-window').forEach(el=>el.classList.add('hidden')); }
    document.getElementById('modal-overlay').addEventListener('click',(e)=>{if(e.target.id==='modal-overlay') closeAllModals();});
    
    function showCategories() {
        const categories = [
            { id: 'cleansing', name: 'Очищение' },
            { id: 'moisturizing', name: 'Увлажнение' },
            { id: 'body', name: 'Уход за телом' },
            { id: 'special', name: 'Специальный уход' }
        ];
        const container = document.getElementById('category-list');
        container.innerHTML = categories.map(cat => `<div class="category-list-item" onclick="openCategoryPage('${cat.id}'); closeAllModals();">${cat.name}</div>`).join('');
    }
    
    function saveData() { localStorage.setItem('gl_cart', JSON.stringify(cart)); localStorage.setItem('gl_wishlist', JSON.stringify(wishlist)); }
    function updateCounters() {
        let cartCount = cart.reduce((s,i)=>s+i.qty,0);
        document.getElementById('cart-count').innerText = cartCount;
        document.getElementById('cart-count').style.display = cartCount>0 ? 'flex' : 'none';
        let wishCount = wishlist.length;
        document.getElementById('wishlist-count').innerText = wishCount;
        document.getElementById('wishlist-count').style.display = wishCount>0 ? 'flex' : 'none';
    }
    function showToast(msg) { let c=document.getElementById('toast-container'); let t=document.createElement('div'); t.className='toast'; t.innerHTML=`<span>${msg}</span>`; c.appendChild(t); setTimeout(()=>{ t.style.opacity='0'; t.style.transform='translateX(100%)'; setTimeout(()=>t.remove(),300); },3000); }

    // Инициализация
    document.addEventListener('DOMContentLoaded', () => {
        updateCounters(); updateUserIcon();
        window.addEventListener('scroll', () => { document.querySelector('.header').classList.toggle('scrolled', window.scrollY>100); });
        function handleHash() {
            let hash = window.location.hash.slice(1);
            if(hash.startsWith('category/')) { let cat=hash.split('/')[1]; if(['cleansing','moisturizing','body','special'].includes(cat)) openCategoryPage(cat); else navigateHome(); }
            else if(hash==='delivery') openDeliveryPage();
            else if(hash==='returns') openReturnsPage();
            else if(hash==='contacts') openContactsPage();
            else if(hash==='blog') openBlogPage();
            else if(hash.startsWith('blog/post/')) { let postId = parseInt(hash.split('/')[2]); if(!isNaN(postId) && blogArticles.find(a=>a.id===postId)) openBlogPost(postId); else navigateHome(); }
            else if(hash==='profile') { if(currentUser) openProfilePage(); else navigateHome(); }
            else if(hash==='eco-details') openEcoDetailsPage();
            else navigateHome();
        }
        handleHash();
        window.addEventListener('hashchange', handleHash);
    });
</script>
</body>
</html>
