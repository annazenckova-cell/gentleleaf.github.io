<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="GentleLeaf - экологическая гипоаллергенная косметика для чувствительной кожи. Прозрачный состав, натуральные ингредиенты, забота о планете.">
    <title>GentleLeaf | HYPOALLERGENIC & ECO-FRIENDLY</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        :root {
            --primary-green: #7CB342;
            --dark-green: #558B2F;
            --light-green: #DCEDC8;
            --brown: #8D6E63;
            --light-brown: #D7CCC8;
            --gold: #BCAAA4;
            --bg-cream: #FAFAFA;
            --text-dark: #3E2723;
            --text-light: #757575;
            --white: #FFFFFF;
            --shadow: rgba(0, 0, 0, 0.08);
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            background-color: var(--bg-cream);
            color: var(--text-dark);
            line-height: 1.6;
            overflow-x: hidden;
        }

        h1, h2, h3, h4, h5, h6 {
            font-family: 'Playfair Display', serif;
            font-weight: 600;
        }

        .header {
            position: fixed;
            top: 0;
            width: 100%;
            background: var(--white);
            box-shadow: 0 2px 10px var(--shadow);
            z-index: 1000;
            transition: var(--transition);
        }

        .header.scrolled {
            box-shadow: 0 4px 20px var(--shadow);
        }

        .header-top {
            background: linear-gradient(135deg, var(--primary-green), var(--dark-green));
            color: var(--white);
            text-align: center;
            padding: 8px;
            font-size: 13px;
            font-weight: 500;
        }

        .header-main {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 5%;
            max-width: 1400px;
            margin: 0 auto;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
        }

        .logo-icon {
            width: 50px;
            height: 50px;
        }

        .logo-icon svg {
            width: 100%;
            height: 100%;
        }

        .logo-text {
            display: flex;
            flex-direction: column;
        }

        .logo-title {
            font-family: 'Playfair Display', serif;
            font-size: 28px;
            color: var(--primary-green);
            font-weight: 700;
            line-height: 1;
        }

        .logo-subtitle {
            font-size: 9px;
            color: var(--brown);
            letter-spacing: 2px;
            text-transform: uppercase;
            margin-top: 2px;
        }

        .nav-menu {
            display: flex;
            list-style: none;
            gap: 40px;
        }

        .nav-menu a {
            text-decoration: none;
            color: var(--text-dark);
            font-weight: 500;
            font-size: 14px;
            transition: var(--transition);
            cursor: pointer;
        }

        .nav-menu a:hover {
            color: var(--primary-green);
        }

        .header-actions {
            display: flex;
            gap: 25px;
            align-items: center;
        }

        .header-icon {
            position: relative;
            cursor: pointer;
            font-size: 20px;
            color: var(--text-dark);
            transition: var(--transition);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .header-icon:hover {
            color: var(--primary-green);
            transform: translateY(-2px);
        }

        .user-avatar {
            width: 36px;
            height: 36px;
            background: var(--primary-green);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: bold;
            font-size: 16px;
        }

        .user-name {
            font-size: 14px;
            font-weight: 500;
        }

        .cart-count {
            position: absolute;
            top: -8px;
            right: -8px;
            background: var(--primary-green);
            color: white;
            font-size: 11px;
            width: 18px;
            height: 18px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
        }

        /* Основной контент (главная страница) */
        .main-content {
            transition: opacity 0.3s;
        }
        .main-content.hidden {
            display: none;
        }

        /* Страницы */
        .category-page, .delivery-page, .returns-page, .contacts-page, .blog-page, .blog-post-page, .profile-page, .eco-details-page {
            display: none;
            padding: 140px 5% 80px;
            max-width: 1400px;
            margin: 0 auto;
        }
        .category-page.active, .delivery-page.active, .returns-page.active, .contacts-page.active, .blog-page.active, .blog-post-page.active, .profile-page.active, .eco-details-page.active {
            display: block;
        }
        .page-header {
            display: flex;
            align-items: center;
            gap: 30px;
            margin-bottom: 40px;
            flex-wrap: wrap;
        }
        .back-home-btn {
            background: none;
            border: 2px solid var(--primary-green);
            color: var(--primary-green);
            padding: 10px 24px;
            border-radius: 40px;
            cursor: pointer;
            font-weight: 600;
            transition: var(--transition);
        }
        .back-home-btn:hover {
            background: var(--primary-green);
            color: white;
        }
        .page-title {
            font-size: 36px;
            color: var(--text-dark);
        }
        .page-content {
            background: white;
            border-radius: 30px;
            padding: 40px;
            box-shadow: 0 5px 20px var(--shadow);
        }
        .page-content h3 {
            margin: 25px 0 15px;
            color: var(--primary-green);
        }
        .page-content p {
            margin-bottom: 15px;
        }

        /* Блог - список статей */
        .blog-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 30px;
            margin-top: 20px;
        }
        .blog-card {
            background: white;
            border-radius: 24px;
            overflow: hidden;
            box-shadow: 0 5px 15px var(--shadow);
            transition: 0.3s;
            cursor: pointer;
        }
        .blog-card:hover {
            transform: translateY(-5px);
        }
        .blog-image {
            height: 200px;
            overflow: hidden;
        }
        .blog-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .blog-content {
            padding: 20px;
        }
        .blog-title {
            font-size: 22px;
            margin-bottom: 12px;
            color: var(--text-dark);
        }
        .blog-excerpt {
            color: #666;
            font-size: 14px;
            margin-bottom: 15px;
        }

        /* Страница отдельной статьи */
        .blog-post-content {
            max-width: 800px;
            margin: 0 auto;
        }
        .blog-post-image {
            width: 100%;
            border-radius: 24px;
            margin-bottom: 30px;
            overflow: hidden;
        }
        .blog-post-image img {
            width: 100%;
            height: auto;
            object-fit: cover;
        }
        .blog-post-text {
            font-size: 16px;
            line-height: 1.8;
        }
        .blog-post-products {
            margin: 30px 0;
            padding: 20px;
            background: var(--light-green);
            border-radius: 20px;
        }
        .blog-product-link {
            display: inline-block;
            background: var(--primary-green);
            color: white;
            padding: 8px 20px;
            border-radius: 30px;
            margin: 5px 10px 5px 0;
            cursor: pointer;
            transition: 0.2s;
            text-decoration: none;
            font-size: 14px;
        }
        .blog-product-link:hover {
            background: var(--dark-green);
        }

        /* Страница контактов */
        .contact-info {
            display: flex;
            flex-direction: column;
            gap: 20px;
            margin-top: 20px;
        }
        .contact-item {
            display: flex;
            align-items: center;
            gap: 15px;
            font-size: 18px;
        }
        .contact-item i {
            width: 40px;
            font-size: 24px;
            color: var(--primary-green);
        }
        .social-links {
            display: flex;
            gap: 20px;
            margin-top: 20px;
            margin-bottom: 30px;
        }
        .social-links a {
            width: 50px;
            height: 50px;
            background: var(--light-green);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            color: var(--dark-green);
            transition: var(--transition);
            text-decoration: none;
        }
        .social-links a:hover {
            background: var(--primary-green);
            color: white;
            transform: translateY(-3px);
        }

        /* Список категорий в модальном окне */
        .category-list {
            display: flex;
            flex-direction: column;
            gap: 15px;
            margin-top: 20px;
        }
        .category-list-item {
            background: var(--bg-cream);
            padding: 20px 30px;
            border-radius: 16px;
            font-size: 20px;
            font-weight: 500;
            cursor: pointer;
            transition: var(--transition);
            border: 2px solid transparent;
            text-align: center;
            font-family: 'Playfair Display', serif;
            color: var(--text-dark);
        }
        .category-list-item:hover {
            border-color: var(--primary-green);
            background: var(--white);
            transform: translateX(8px);
            color: var(--primary-green);
        }

        /* Продукты (категории) */
        .products-grid-category {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
            gap: 30px;
        }
        .category-product-card {
            background: var(--white);
            border-radius: 20px;
            overflow: hidden;
            transition: var(--transition);
            box-shadow: 0 5px 15px var(--shadow);
        }
        .category-product-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 30px var(--shadow);
        }
        .category-product-img {
            height: 220px;
            background: linear-gradient(135deg, var(--light-green), var(--light-brown));
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 80px;
        }
        .category-product-img img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }
        .category-product-info {
            padding: 20px;
        }
        .category-product-name {
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 8px;
        }
        .category-product-desc {
            font-size: 13px;
            color: #757575;
            margin-bottom: 12px;
        }
        .category-product-price {
            font-size: 20px;
            font-weight: bold;
            color: var(--primary-green);
            margin-bottom: 15px;
        }
        .category-product-actions {
            display: flex;
            gap: 10px;
        }
        .btn-cat-cart {
            flex: 1;
            padding: 10px;
            background: var(--primary-green);
            color: white;
            border: none;
            border-radius: 30px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.2s;
        }
        .btn-cat-cart:hover {
            background: var(--dark-green);
        }
        .btn-cat-wish {
            width: 44px;
            background: white;
            border: 2px solid #ddd;
            border-radius: 30px;
            cursor: pointer;
            font-size: 18px;
            transition: 0.2s;
        }
        .btn-cat-wish.active {
            border-color: red;
            color: red;
        }
        .btn-cat-ingredient {
            background: none;
            border: 1px solid var(--primary-green);
            border-radius: 30px;
            padding: 6px 12px;
            font-size: 12px;
            margin-top: 12px;
            cursor: pointer;
            color: var(--primary-green);
            width: 100%;
        }

        /* Hero и другие секции */
        .hero {
            margin-top: 120px;
            padding: 80px 5%;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3e6cb 100%);
        }
        .hero-container {
            max-width: 1400px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 60px;
            align-items: center;
        }
        .hero-content h1 {
            font-size: 52px;
            line-height: 1.2;
            margin-bottom: 20px;
        }
        .hero-content h1 span {
            color: var(--primary-green);
        }
        .hero-tagline {
            font-size: 20px;
            color: var(--brown);
            margin-bottom: 30px;
            font-weight: 500;
        }
        .hero-description {
            font-size: 16px;
            color: var(--text-light);
            margin-bottom: 40px;
        }
        .hero-buttons {
            display: flex;
            gap: 20px;
            flex-wrap: wrap;
        }
        .btn {
            padding: 16px 32px;
            border: none;
            border-radius: 30px;
            font-weight: 600;
            font-size: 14px;
            cursor: pointer;
            transition: var(--transition);
            display: inline-flex;
            align-items: center;
            gap: 10px;
        }
        .btn-primary {
            background: linear-gradient(135deg, var(--primary-green), var(--dark-green));
            color: var(--white);
            box-shadow: 0 4px 15px rgba(124, 179, 66, 0.3);
        }
        .btn-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(124, 179, 66, 0.4);
        }
        .btn-secondary {
            background: var(--white);
            color: var(--primary-green);
            border: 2px solid var(--primary-green);
        }
        .btn-secondary:hover {
            background: var(--primary-green);
            color: var(--white);
        }
        .hero-image-placeholder {
            width: 100%;
            max-width: 500px;
            height: 500px;
            background: linear-gradient(135deg, var(--light-green), var(--light-brown));
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 200px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.1);
        }
        .features {
            padding: 80px 5%;
            background: var(--white);
        }
        .container {
            max-width: 1400px;
            margin: 0 auto;
        }
        .section-title {
            text-align: center;
            margin-bottom: 60px;
        }
        .section-title h2 {
            font-size: 42px;
            margin-bottom: 15px;
        }
        .features-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 40px;
        }
        .feature-card {
            background: var(--bg-cream);
            padding: 40px 30px;
            border-radius: 20px;
            text-align: center;
            transition: var(--transition);
            border: 2px solid transparent;
        }
        .feature-card:hover {
            transform: translateY(-10px);
            border-color: var(--primary-green);
        }
        .feature-icon {
            width: 80px;
            height: 80px;
            background: linear-gradient(135deg, var(--light-green), var(--light-brown));
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 25px;
            font-size: 36px;
        }
        .quiz-section {
            padding: 100px 5%;
            background: linear-gradient(135deg, var(--primary-green), var(--dark-green));
            color: white;
            text-align: center;
        }
        .quiz-content {
            max-width: 800px;
            margin: 0 auto;
        }
        .quiz-section h2 {
            font-size: 42px;
            margin-bottom: 20px;
        }
        .quiz-section p {
            font-size: 18px;
            margin-bottom: 40px;
        }
        .eco-section {
            padding: 80px 5%;
            background: var(--bg-cream);
        }
        .eco-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 60px;
            align-items: center;
            max-width: 1400px;
            margin: 0 auto;
        }
        .eco-image {
            background: linear-gradient(135deg, var(--light-green), var(--light-brown));
            border-radius: 30px;
            height: 500px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 150px;
        }
        .eco-stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 30px;
            margin-top: 40px;
        }
        .eco-stat-number {
            font-size: 48px;
            font-weight: 700;
            color: var(--primary-green);
            display: block;
        }
        .footer {
            background: var(--text-dark);
            color: white;
            padding: 80px 5% 30px;
        }
        .footer-grid {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr 1fr;
            gap: 60px;
            margin-bottom: 60px;
            max-width: 1400px;
            margin-left: auto;
            margin-right: auto;
        }
        .footer-brand .logo-title {
            color: var(--primary-green);
            margin-bottom: 20px;
        }
        .footer-social {
            display: flex;
            gap: 15px;
            margin-top: 20px;
        }
        .footer-social a {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: rgba(255,255,255,0.1);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            transition: var(--transition);
            text-decoration: none;
        }
        .footer-social a:hover {
            background: var(--primary-green);
        }
        .footer-column h4 {
            color: var(--primary-green);
            margin-bottom: 25px;
        }
        .footer-column ul {
            list-style: none;
        }
        .footer-column li {
            margin-bottom: 12px;
        }
        .footer-column a {
            color: rgba(255,255,255,0.7);
            text-decoration: none;
            transition: var(--transition);
            cursor: pointer;
        }
        .footer-column a:hover {
            color: var(--primary-green);
        }

        /* Модалки */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.6);
            z-index: 2000;
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s ease;
            backdrop-filter: blur(5px);
        }
        .modal-overlay.active {
            opacity: 1;
            visibility: visible;
        }
        .modal-window {
            background: white;
            width: 90%;
            max-width: 900px;
            max-height: 90vh;
            border-radius: 20px;
            padding: 40px;
            position: relative;
            transform: translateY(30px);
            transition: transform 0.3s ease;
            overflow-y: auto;
        }
        .modal-overlay.active .modal-window {
            transform: translateY(0);
        }
        .modal-close {
            position: absolute;
            top: 20px;
            right: 20px;
            font-size: 30px;
            background: none;
            border: none;
            cursor: pointer;
            color: #757575;
        }
        .modal-close:hover {
            color: var(--primary-green);
        }
        .hidden {
            display: none !important;
        }
        #toast-container {
            position: fixed;
            bottom: 30px;
            right: 30px;
            z-index: 3000;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }
        .toast {
            background: white;
            padding: 15px 25px;
            border-radius: 10px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
            display: flex;
            align-items: center;
            gap: 10px;
            animation: slideInRight 0.3s ease-out;
            border-left: 5px solid var(--primary-green);
        }
        @keyframes slideInRight {
            from { transform: translateX(100%); opacity: 0; }
            to { transform: translateX(0); opacity: 1; }
        }
        .cart-item, .wishlist-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px 0;
            border-bottom: 1px solid #eee;
        }
        .cart-item-info, .wishlist-item-info {
            display: flex;
            align-items: center;
            gap: 15px;
        }
        .product-thumb {
            width: 60px;
            height: 60px;
            object-fit: cover;
            border-radius: 12px;
        }
        .profile-menu {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            margin-top: 20px;
        }
        .profile-card {
            background: var(--bg-cream);
            padding: 20px;
            border-radius: 10px;
        }
        .quiz-question {
            margin-bottom: 30px;
        }
        .quiz-question p {
            font-weight: 600;
            margin-bottom: 15px;
            font-size: 18px;
        }
        .quiz-option {
            display: block;
            margin: 10px 0;
        }
        .quiz-option label {
            margin-left: 8px;
            cursor: pointer;
        }
        .quiz-nav {
            display: flex;
            justify-content: space-between;
            margin-top: 30px;
        }
        .quiz-result-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            padding: 10px;
            background: var(--bg-cream);
            border-radius: 12px;
        }
        .form-group {
            margin-bottom: 20px;
        }
        .form-group label {
            display: block;
            margin-bottom: 6px;
            font-weight: 500;
        }
        .form-group input, .form-group select, .form-group textarea {
            width: 100%;
            padding: 12px;
            border: 1px solid #ddd;
            border-radius: 8px;
            font-family: inherit;
        }
        .order-summary {
            background: #f9f9f9;
            padding: 15px;
            border-radius: 16px;
            margin: 20px 0;
        }
        .summary-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 10px;
        }
        .summary-total {
            font-weight: bold;
            font-size: 18px;
            border-top: 1px solid #ddd;
            padding-top: 10px;
            margin-top: 5px;
        }
        .carbon-checkbox {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            margin: 20px 0;
            background: var(--light-green);
            padding: 16px;
            border-radius: 20px;
        }
        .carbon-checkbox input {
            margin-top: 3px;
            width: 20px;
            height: 20px;
            cursor: pointer;
        }

